{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Local TypeScript tsconfig schema",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "properties": {
    "compilerOptions": { "type": "object" },
    "include": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extends": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "references": { "type": "array" },
    "compileOnSave": { "type": "boolean" }
  }
}
